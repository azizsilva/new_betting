# ───────────────────────────────────────────────
# BetSlate — Server environment
# Copy to .env and fill in real values. NEVER commit .env.
# ───────────────────────────────────────────────

# Neon serverless Postgres connection string (pooled)
# Get from https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/betslate?sslmode=require"

# Direct (non-pooled) URL — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/betslate?sslmode=require"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# Auth — generate strong random secrets: `openssl rand -hex 48`
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
COOKIE_DOMAIN="localhost"

# ─── External provider integrations (your APIs) ───
# Odds / sportsbook feed
ODDS_API_BASE_URL=""
ODDS_API_KEY=""

# iGaming / casino aggregator
IGAMING_API_BASE_URL=""
IGAMING_API_KEY=""
IGAMING_OPERATOR_ID=""

# Gambly provider
GAMBLY_API_BASE_URL=""
GAMBLY_API_KEY=""

# Payments / PSP (fill when ready)
PSP_API_BASE_URL=""
PSP_API_KEY=""
PSP_WEBHOOK_SECRET=""
