# ─────────────────────────────────────────────────────────────
# AfroBet216 — PRODUCTION server env (VPS / Hostinger)
# Copy to /var/www/afrobet/server/.env  and fill the real values.
# This file is committed only as a TEMPLATE — never put real secrets here.
# ─────────────────────────────────────────────────────────────

# Neon serverless Postgres (same DB as dev, or a separate prod branch)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Server
PORT=4000
NODE_ENV=production
# The public site origin (used by CORS). Your real domain:
CLIENT_ORIGIN="https://afrobet216.com"

# Auth — generate strong secrets:  openssl rand -hex 48
JWT_ACCESS_SECRET="GENERATE_ME"
JWT_REFRESH_SECRET="GENERATE_ME"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
COOKIE_DOMAIN="afrobet216.com"

# Casino providers (fill when ready)
IGAMING_API_BASE_URL=""
IGAMING_API_KEY=""
IGAMING_OPERATOR_ID=""
# ─── Gamblly game launcher (V1 seamless wallet — live casino) ───
# Set GAMBLY_API_KEY to your agency_uid from the Gamblly panel. The callback URL
# you configure in the Gamblly panel MUST be: https://afrobet216.com/api/gambly/callback
GAMBLY_API_BASE_URL="https://game.gambllyapi.com/production/"
GAMBLY_API_KEY=""
GAMBLY_CALLBACK_URL="https://afrobet216.com/api/gambly/callback"
GAMBLY_CURRENCY="TND"

# ─── Gamble Hub aggregator (Evolution, Amatic, slots, live casino) ───
# Get LOGIN / PASSWORD / USER_ID + secret from your Gamble Hub manager.
# Until LOGIN+PASSWORD+USER_ID are set, /api/casino/games returns 503.
# Integration starts on STAGE (-dev). Switch to the prod hosts (no -dev) only
# after the integration is approved for production:
#   GAMBLEHUB_OFFICE_URL="https://office-api.gamble-hub.net"
#   GAMBLEHUB_CLIENT_URL="https://client-api.gamble-hub.net"
GAMBLEHUB_OFFICE_URL="https://office-api-dev.gamble-hub.net"
GAMBLEHUB_CLIENT_URL="https://client-api-dev.gamble-hub.net"
GAMBLEHUB_LOGIN=""
GAMBLEHUB_PASSWORD=""
GAMBLEHUB_USER_ID=""
GAMBLEHUB_SECRET=""
# The callback URL you give Gamble Hub (per-currency seamless wallet):
GAMBLEHUB_CALLBACK_URL="https://afrobet216.com/api/casino/callback"

# PSP (optional)
PSP_API_BASE_URL=""
PSP_API_KEY=""
PSP_WEBHOOK_SECRET=""
